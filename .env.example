# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery via Resend (https://resend.com). Leave empty to keep the
# form in its honest "not connected" state.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender verified in Resend, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Optional: raises the GitHub API rate limit for the activity section.
# Use a token with NO scopes (public data only). Server-side only.
GITHUB_TOKEN=
